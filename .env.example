# HiveMind local / deploy env. Copy to .env (gitignored).
#
# Cloudflare Worker secrets are NOT read from this file in production; use:
#   bun run deploy            # runs tools/deploy.sh all production
#   tools/deploy.sh secrets production
#
# hivemind CLI (packages/cli): where the API is and how to authenticate.
HIVEMIND_API_URL=http://localhost:3000
# Access service token for the CLI against a deployed environment (D-033).
# HIVEMIND_ACCESS_CLIENT_ID=
# HIVEMIND_ACCESS_CLIENT_SECRET=
# Who acts in work orders and publishes (default: git user.name).
# HIVEMIND_ACTOR=jacob
#
# Scopes granted to service tokens, applied with tools/deploy.sh secrets.
# HIVEMIND_SERVICE_TOKEN_SCOPES={"<client-id>.access":["content:publish","export:read"]}
