# HiveMind local / deploy env. Copy to .env (gitignored).
#
# Cloudflare Worker secrets are NOT read from this file in production; use:
#   bun run deploy            # runs tools/deploy.sh all production
#   tools/deploy.sh secret production
#
# Shared guest-session HMAC secret. Must be identical everywhere:
#   - this file (HIVEMIND_GUEST_SESSION_SECRET) for the deploy helper
#   - apps/web/.dev.vars (GUEST_SESSION_SECRET) for local `next dev`
#   - apps/realtime-worker/.dev.vars (GUEST_SESSION_SECRET) for the local worker
# Generate one with: openssl rand -base64 48
HIVEMIND_GUEST_SESSION_SECRET=replace-with-at-least-32-random-bytes
