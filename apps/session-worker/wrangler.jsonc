{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hivemind-session-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Browser origins allowed to call this Worker directly (local `next dev`),
    // plus the trusted origin the web Worker stamps on proxied requests.
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://hivemind-web.internal",
    // Cloudflare Access (D-033). Local dev bypasses via .dev.vars.
    "ACCESS_TEAM_DOMAIN": "https://royal-breeze-2b7c.cloudflareaccess.com",
    "ACCESS_AUD": "0c109a114e394c77ac0d9805e440acd8773a717c4bdfbf521142876f7022ebf4",
    "HIVEMIND_ENV": "development",
    // Providers (D-035): the Sandbox binding below and any lab worker that heartbeats;
    // the loopback agent stands in for a lab worker outside production.
    "SANDBOX_ENABLED": "true",
    "SANDBOX_SLEEP_AFTER": "20m",
    "PROVIDER_LOOPBACK": "true",
  },
  // Same D1 database as the web Worker: identity → learner_id mapping, the
  // lab_sessions index, the worker registry, and the session event log (D-030).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hivemind-dev",
      "database_id": "7aaf747b-bd2b-4f98-9271-f570ad63a9b7",
      "migrations_dir": "../web/migrations",
    },
  ],
  // Recordings (asciicast, redacted) and other session artifacts (D-019).
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "hivemind-artifacts-dev" }],
  "services": [{ "binding": "SELF", "service": "hivemind-session-dev" }],
  "durable_objects": {
    "bindings": [
      { "name": "LAB_SESSIONS", "class_name": "LabSession" },
      { "name": "Sandbox", "class_name": "Sandbox" },
    ],
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./sandbox/Dockerfile",
      "instance_type": "basic",
      "max_instances": 4,
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LabSession"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
  ],
  "env": {
    "production": {
      "name": "hivemind-session",
      "compatibility_flags": ["nodejs_compat"],
      "observability": { "enabled": true },
      "vars": {
        "ALLOWED_ORIGINS": "https://hivemind-web.internal",
        "ACCESS_TEAM_DOMAIN": "https://royal-breeze-2b7c.cloudflareaccess.com",
        "ACCESS_AUD": "0c109a114e394c77ac0d9805e440acd8773a717c4bdfbf521142876f7022ebf4",
        "HIVEMIND_ENV": "production",
        "SANDBOX_ENABLED": "true",
        "SANDBOX_SLEEP_AFTER": "20m",
        "PROVIDER_LOOPBACK": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hivemind",
          "database_id": "51e411b9-b8b2-4a9a-93b3-7c2a33d3d720",
          "migrations_dir": "../web/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "hivemind-artifacts" }],
      "services": [{ "binding": "SELF", "service": "hivemind-session" }],
      "durable_objects": {
        "bindings": [
          { "name": "LAB_SESSIONS", "class_name": "LabSession" },
          { "name": "Sandbox", "class_name": "Sandbox" },
        ],
      },
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./sandbox/Dockerfile",
          "instance_type": "basic",
          "max_instances": 4,
        },
      ],
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["LabSession"] },
        { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
      ],
    },
  },
}
