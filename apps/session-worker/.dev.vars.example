# Copy to .dev.vars (gitignored). Local development only.
# Act as this learner when no Access token is present (HIVEMIND_ENV=development only).
ACCESS_DEV_BYPASS_EMAIL=you@example.com
# Optional: JSON map of Access service-token Client IDs to scopes.
# SERVICE_TOKEN_SCOPES={"<cli-id>.access":["lab:operate"],"<worker-id>.access":["worker:callback"]}
# Service token presented to lab workers behind Access (production secrets; unused by the loopback agent).
# LAB_WORKER_CLIENT_ID=
# LAB_WORKER_CLIENT_SECRET=
