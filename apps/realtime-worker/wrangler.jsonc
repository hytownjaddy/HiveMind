{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hivemind-realtime-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "vars": {
    // Browser origins allowed to call this Worker directly (local `next dev`),
    // plus the trusted origin the web Worker stamps on proxied requests.
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://hivemind-web.internal",
    // Which LabProvider backs sessions. "echo" is the in-object dev stub;
    // real providers (docker, containerlab, frr, k8s) live on lab hosts.
    "LAB_PROVIDER": "echo",
  },
  "durable_objects": {
    "bindings": [{ "name": "LAB_SESSIONS", "class_name": "LabSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LabSession"] }],
  // Future bindings (RFP §82-84). Uncomment once the resources exist:
  // "queues": { "producers": [{ "binding": "LAB_JOBS", "queue": "hivemind-lab-jobs" }] },
  // "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "hivemind-artifacts" }],
  "env": {
    "production": {
      "name": "hivemind-realtime",
      "observability": { "enabled": true },
      "vars": {
        "ALLOWED_ORIGINS": "https://hivemind-web.internal",
        "LAB_PROVIDER": "echo",
      },
      "durable_objects": {
        "bindings": [{ "name": "LAB_SESSIONS", "class_name": "LabSession" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LabSession"] }],
    },
  },
}
