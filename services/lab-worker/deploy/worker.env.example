# /etc/hivemind/worker.env — written by tools/host/provision.sh; secrets live only here (mode 0600).
HIVEMIND_WORKER_ID=ubuntu-lab-worker-1
HIVEMIND_SESSION_URL=https://hivemind.jryans.dev
HIVEMIND_WORKER_ENDPOINT=https://lab-worker.jryans.dev
HIVEMIND_ACCESS_TEAM_DOMAIN=https://royal-breeze-2b7c.cloudflareaccess.com
# AUD tag of the lab-worker Access application (protects lab-worker.jryans.dev).
HIVEMIND_WORKER_ACCESS_AUD=
# Service token the agent presents to the session Worker (scope worker:callback).
HIVEMIND_ACCESS_CLIENT_ID=
HIVEMIND_ACCESS_CLIENT_SECRET=
HIVEMIND_WORKER_LISTEN=127.0.0.1:8790
HIVEMIND_WORKER_STATE_DIR=/var/lib/hivemind-worker
