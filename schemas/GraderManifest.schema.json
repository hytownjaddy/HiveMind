{
  "$comment": "HiveMind contract GraderManifest v1.0.0; generated from packages/schema, do not edit",
  "$id": "GraderManifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Grader manifest",
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "objective_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "spec": {
            "$ref": "CheckSpec.schema.json"
          },
          "weight": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "description",
          "weight",
          "hidden"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "entrypoint": {
      "pattern": "^[a-z0-9_.]+:[a-z0-9_]+$",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "deterministic",
        "test_runner"
      ],
      "type": "string"
    },
    "requires": {
      "items": {
        "$ref": "Capability.schema.json"
      },
      "type": "array"
    },
    "status": {
      "$ref": "DefinitionStatus.schema.json"
    },
    "timeout_seconds": {
      "maximum": 3600,
      "minimum": 1,
      "type": "integer"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "description": "Semantic version major.minor.patch",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "title",
    "status",
    "kind",
    "requires",
    "checks",
    "entrypoint",
    "timeout_seconds"
  ],
  "title": "GraderManifest",
  "type": "object"
}
