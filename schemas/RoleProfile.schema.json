{
  "$comment": "HiveMind contract RoleProfile v1.0.0; generated from packages/schema, do not edit",
  "$id": "RoleProfile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Role profile",
  "properties": {
    "company": {
      "maxLength": 120,
      "type": "string"
    },
    "competencies": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "competency_id": {
            "maxLength": 128,
            "minLength": 1,
