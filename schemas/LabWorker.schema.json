        {
          "maxLength": 2048,
          "pattern": "^https?:\\/\\/[^\\s/$.?#][^\\s]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostname": {
      "anyOf": [
        {
          "maxLength": 253,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
