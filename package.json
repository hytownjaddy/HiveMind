{
  "name": "hivemind",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:web": "bun --cwd apps/web dev",
    "dev:session": "bun --cwd apps/session-worker dev",
    "preview": "bun run build:web && bun --cwd apps/web preview",
    "build": "bun run build:web",
    "build:web": "bun --cwd apps/web build:cloudflare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "boundaries": "bunx --bun depcruise apps packages --config dependency-cruiser.config.cjs",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run test:unit && bun run test:core && bun run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "bun --cwd apps/session-worker test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:local": "bun --cwd apps/web db:migrate:local",
    "db:migrate:remote": "bun --cwd apps/web db:migrate:remote",
    "db:migrate:production": "bun --cwd apps/web db:migrate:production",
    "cf-typegen": "bun run --filter './apps/*' cf-typegen",
    "deploy": "tools/deploy.sh all production",
    "deploy:dev": "tools/deploy.sh all dev",
    "verify": "bun run format:check && bun run lint && bun run boundaries && bun run typecheck && bun run schema:check && bun run test && bun run build:web",
    "schema:export": "bun --cwd packages/schema schema:export",
    "schema:check": "bun --cwd packages/schema schema:check",
    "verify:py": "uv run --directory services/lab-worker task verify",
    "verify:all": "bun run verify && bun run verify:py",
    "test:core": "bun --cwd packages/core test",
    "hivemind": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
